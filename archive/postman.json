{
  "info": {
    "name": "GoldBag Backend - Full API",
    "_postman_id": "goldbag-backend-collection",
    "description": "Postman collection for GoldBag backend API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string",
      "description": "Base URL for the API (include /api if applicable)"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Set after login: Bearer token value (without 'Bearer ' prefix)"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"username\": \"user123\",\n  \"password\": \"Str0ngPass!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth","register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"user@example.com\",\n  \"password\": \"Str0ngPass!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth","login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh_token_here>\"\n}" },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth","refresh"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth","forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewStr0ngPass!\"\n}" },
            "url": { "raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth","reset-password"] }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/verify-email", "host": ["{{base_url}}"], "path": ["auth","verify-email"] }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "url": { "raw": "{{base_url}}/auth/resend-otp", "host": ["{{base_url}}"], "path": ["auth","resend-otp"] }
          }
        },
        {
          "name": "Verification Status",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "url": { "raw": "{{base_url}}/auth/verification-status", "host": ["{{base_url}}"], "path": ["auth","verification-status"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh_token_here>\"\n}" },
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth","logout"] }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth","me"] }
          }
        }
      ]
    },
    {
      "name": "Funding",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100.00,\n  \"currency\": \"USD\",\n  \"method\": \"bank_transfer\"\n}" },
            "url": { "raw": "{{base_url}}/funding/deposit", "host": ["{{base_url}}"], "path": ["funding","deposit"] }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50.00,\n  \"currency\": \"USD\",\n  \"destination\": \"bank_account_123\"\n}" },
            "url": { "raw": "{{base_url}}/funding/withdraw", "host": ["{{base_url}}"], "path": ["funding","withdraw"] }
          }
        },
        {
          "name": "Preview Funding",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100.00,\n  \"currency\": \"USD\"\n}" },
            "url": { "raw": "{{base_url}}/funding/preview", "host": ["{{base_url}}"], "path": ["funding","preview"] }
          }
        },
        {
          "name": "Funding History",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/funding/history", "host": ["{{base_url}}"], "path": ["funding","history"] } }
        },
        {
          "name": "Pending Funding",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/funding/pending", "host": ["{{base_url}}"], "path": ["funding","pending"] } }
        },
        {
          "name": "Cancel Funding",
          "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/funding/:fundingId/cancel", "host": ["{{base_url}}"], "path": ["funding",":fundingId","cancel"] }, "description": "Replace :fundingId with actual ID" }
        },
        {
          "name": "Funding Config",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/funding/config", "host": ["{{base_url}}"], "path": ["funding","config"] } }
        },
        {
          "name": "Funding Health",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/funding/health", "host": ["{{base_url}}"], "path": ["funding","health"] } }
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        { "name": "Summary", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/portfolio/summary", "host": ["{{base_url}}"], "path": ["portfolio","summary"] } } },
        { "name": "Value", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/portfolio/value", "host": ["{{base_url}}"], "path": ["portfolio","value"] } } },
        { "name": "PNL", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/portfolio/pnl", "host": ["{{base_url}}"], "path": ["portfolio","pnl"] } } },
        { "name": "PNL Detailed", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/portfolio/pnl/detailed", "host": ["{{base_url}}"], "path": ["portfolio","pnl","detailed"] } } },
        { "name": "Statistics", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/portfolio/statistics", "host": ["{{base_url}}"], "path": ["portfolio","statistics"] } } }
      ]
    },
    {
      "name": "Price",
      "item": [
        { "name": "Current Price", "request": { "method": "GET", "url": { "raw": "{{base_url}}/price/current", "host": ["{{base_url}}"], "path": ["price","current"] } } },
        { "name": "Price History", "request": { "method": "GET", "url": { "raw": "{{base_url}}/price/history", "host": ["{{base_url}}"], "path": ["price","history"] } } },
        { "name": "Price Range", "request": { "method": "GET", "url": { "raw": "{{base_url}}/price/range?from=2025-01-01&to=2025-02-01", "host": ["{{base_url}}"], "path": ["price","range"], "query": [ { "key": "from", "value": "2025-01-01" }, { "key": "to", "value": "2025-02-01" } ] } } },
        { "name": "Price Stats", "request": { "method": "GET", "url": { "raw": "{{base_url}}/price/stats", "host": ["{{base_url}}"], "path": ["price","stats"] } } },
        { "name": "Trigger Price Update", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/price/update", "host": ["{{base_url}}"], "path": ["price","update"] }, "description": "Protected: requires authentication and email verification (admin recommended)" } }
      ]
    },
    {
      "name": "Savings",
      "item": [
        { "name": "Create Savings", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Holiday Fund\",\n  \"amount\": 50.00,\n  \"currency\": \"USD\",\n  \"frequency\": \"monthly\"\n}" }, "url": { "raw": "{{base_url}}/savings/create", "host": ["{{base_url}}"], "path": ["savings","create"] } } },
        { "name": "Withdraw Savings", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"savingsId\": \"<id>\",\n  \"amount\": 25.00\n}" }, "url": { "raw": "{{base_url}}/savings/withdraw", "host": ["{{base_url}}"], "path": ["savings","withdraw"] } } },
        { "name": "Get User Savings", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/savings", "host": ["{{base_url}}"], "path": ["savings"] } } },
        { "name": "Get Savings Details", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/savings/:savingsId", "host": ["{{base_url}}"], "path": ["savings",":savingsId"] }, "description": "Replace :savingsId with actual ID" } },
        { "name": "Savings Preview", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"amount\": 100.00,\n  \"durationMonths\": 12\n}" }, "url": { "raw": "{{base_url}}/savings/preview", "host": ["{{base_url}}"], "path": ["savings","preview"] } } },
        { "name": "Savings Summary", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/savings/summary", "host": ["{{base_url}}"], "path": ["savings","summary"] } } },
        { "name": "Savings Config", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/savings/config", "host": ["{{base_url}}"], "path": ["savings","config"] } } },
        { "name": "Savings Health", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/savings/health", "host": ["{{base_url}}"], "path": ["savings","health"] } } },
        { "name": "Calculate Interest", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"savingsId\": \"<id>\"\n}" }, "url": { "raw": "{{base_url}}/savings/:savingsId/calculate-interest", "host": ["{{base_url}}"], "path": ["savings",":savingsId","calculate-interest"] }, "description": "Replace :savingsId with actual ID" } }
      ]
    },
    {
      "name": "Trading",
      "item": [
        { "name": "Buy Gold", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"amountFiat\": 100.00,\n  \"currency\": \"USD\"\n}" }, "url": { "raw": "{{base_url}}/trading/buy", "host": ["{{base_url}}"], "path": ["trading","buy"] } } },
        { "name": "Sell Gold", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"amountGold\": 1.5\n}" }, "url": { "raw": "{{base_url}}/trading/sell", "host": ["{{base_url}}"], "path": ["trading","sell"] } } },
        { "name": "Trading Summary", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/trading/summary", "host": ["{{base_url}}"], "path": ["trading","summary"] } } },
        { "name": "User Balances", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/trading/balances", "host": ["{{base_url}}"], "path": ["trading","balances"] } } },
        { "name": "Trade Preview", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"amountFiat\": 100.00,\n  \"currency\": \"USD\"\n}" }, "url": { "raw": "{{base_url}}/trading/preview", "host": ["{{base_url}}"], "path": ["trading","preview"] } } },
        { "name": "Trading Config", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/trading/config", "host": ["{{base_url}}"], "path": ["trading","config"] } } },
        { "name": "Trading Health", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/trading/health", "host": ["{{base_url}}"], "path": ["trading","health"] } } }
      ]
    },
    {
      "name": "Transaction History",
      "item": [
        { "name": "Transaction History", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transaction/history", "host": ["{{base_url}}"], "path": ["transaction","history"] } } },
        { "name": "Transaction Stats", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transaction/stats", "host": ["{{base_url}}"], "path": ["transaction","stats"] } } },
        { "name": "Export Transactions", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transaction/export", "host": ["{{base_url}}"], "path": ["transaction","export"] } } },
        { "name": "Transaction By ID", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transaction/:transactionId", "host": ["{{base_url}}"], "path": ["transaction",":transactionId"] }, "description": "Replace :transactionId with actual ID" } },
        { "name": "Transaction Health", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transaction/health", "host": ["{{base_url}}"], "path": ["transaction","health"] } } }
