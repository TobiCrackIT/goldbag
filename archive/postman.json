    },
    {
      "name": "Transfer",
      "item": [
        { "name": "Send Gold", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"user2@example.com\",\n  \"amountGold\": 0.5,\n  \"note\": \"For lunch\"\n}" }, "url": { "raw": "{{base_url}}/transfer/send", "host": ["{{base_url}}"], "path": ["transfer","send"] } } },
        { "name": "Validate Recipient", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"user2@example.com\"\n}" }, "url": { "raw": "{{base_url}}/transfer/validate-recipient", "host": ["{{base_url}}"], "path": ["transfer","validate-recipient"] } } },
        { "name": "Transfer Preview", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"user2@example.com\",\n  \"amountGold\": 0.5\n}" }, "url": { "raw": "{{base_url}}/transfer/preview", "host": ["{{base_url}}"], "path": ["transfer","preview"] } } },
        { "name": "Transfer History", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transfer/history", "host": ["{{base_url}}"], "path": ["transfer","history"] } } },
        { "name": "Pending Transfers", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transfer/pending", "host": ["{{base_url}}"], "path": ["transfer","pending"] } } },
        { "name": "Cancel Transfer", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transfer/:transferId/cancel", "host": ["{{base_url}}"], "path": ["transfer",":transferId","cancel"] }, "description": "Replace :transferId with actual ID" } },
        { "name": "Transfer Config", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transfer/config", "host": ["{{base_url}}"], "path": ["transfer","config"] } } },
        { "name": "Transfer Health", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ], "url": { "raw": "{{base_url}}/transfer/health", "host": ["{{base_url}}"], "path": ["transfer","health"] } } }
