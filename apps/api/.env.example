# Copy to .env for local development. Every variable here must exist in
# src/config/env.ts — the process refuses to boot otherwise.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local dev Postgres (docker run postgres:16-alpine — see README)
DATABASE_URL=postgresql://postgres:goldbag@localhost:5432/goldbag

# Local dev Redis (docker run redis:7-alpine)
REDIS_URL=redis://localhost:6379

# Privy (auth vendor adapter — architecture §4.3b). Dashboard → app settings.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Allowlist token for /admin asset-registry routes (openssl rand -hex 24).
# Leave unset to disable the admin surface entirely.
ADMIN_TOKEN=
