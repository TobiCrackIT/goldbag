{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "dev", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "dev", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" }
    },
    "staging": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": { "APP_VARIANT": "prod", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
